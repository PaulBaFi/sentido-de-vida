# Plantilla documental: no se carga automáticamente en todos los paquetes.
# Web: copiar solo las variables públicas necesarias a apps/web/.env.local.
# Supabase Auth: ambas vacías permiten la portada sin Auth.
# Al crear un cliente, ambas son obligatorias. No hay valores reales ni de respaldo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

NEXT_PUBLIC_APP_URL=
# Solo servidor Next.js. Local: http://127.0.0.1:4001; remoto exige HTTPS.
USERS_API_URL=
NEXT_PUBLIC_CATALOG_API_URL=
NEXT_PUBLIC_APPOINTMENTS_API_URL=
NEXT_PUBLIC_PAYMENTS_API_URL=
NEXT_PUBLIC_NOTIFICATIONS_API_URL=

# Futuro backend: variables documentadas, todavía no consumidas por los servicios.
# Ver docs/arquitectura/SUPABASE_INTEGRATION.md; NO copiar estas variables al frontend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Condicional a aprobar acceso PostgreSQL: credencial restringida por servicio,
# nunca una conexión compartida con postgres, superusuario o BYPASSRLS.
DATABASE_URL=
PORT=
# No configurar claves secret/service_role en esta fase.
