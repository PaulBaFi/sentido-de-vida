# Solo backend. Copiar la configuración FUERA del repositorio; secretos en archivos privados.
# El servicio NO carga este archivo ni apps/web/.env.local automáticamente.
USERS_PG_ENABLED=false
USERS_PG_MODE=
USERS_PG_HOST=
USERS_PG_PORT=
USERS_PG_DATABASE=
USERS_PG_USER=
USERS_PG_PASSWORD_FILE=
USERS_PG_CA_FILE=
USERS_AUTH_URL=
USERS_AUTH_PUBLISHABLE_KEY=
PORT=4001
# Solo pruebas en entorno aislado, con dos perfiles sintéticos ya preparados por un operador:
USERS_PG_INTEGRATION_TESTS=
USERS_PG_TEST_SUBJECT=
USERS_PG_TEST_OTHER_SUBJECT=
